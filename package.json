{
  "name": "printify",
  "version": "0.1.0",
  "description": "Printify: print e gravação de tela",
  "main": "./out/main/index.js",
  "author": "Antonio Gonçalves",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens": "node scripts/gen-tokens.mjs",
    "icons": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "version:compute": "node scripts/compute-version.mjs"
  },
  "build": {
    "appId": "io.github.tonissx.printify",
    "productName": "Printify",
    "files": [
      "out/**",
      "resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/**",
      "resources/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "tonissx",
      "repo": "printify",
      "releaseType": "release"
    },
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.printify.txt"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "LICENSE.ffmpeg.txt"
      }
    ]
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@emnapi/core": "^2.0.0-beta.2",
    "@emnapi/runtime": "^2.0.0-beta.2",
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "homepage": "https://github.com/tonissx/printify",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonissx/printify.git"
  }
}
